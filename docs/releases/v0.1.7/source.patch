+#[cfg(test)]
+mod partition_tests {
+    use super::*;
+    #[test]
+    fn requires_idr_vcl_and_valid_avcc_not_an_i_picture_flag() {
+        assert!(is_idr(&[0, 0, 0, 2, 0x65, 0x88], 4).unwrap());
+        assert!(!is_idr(&[0, 0, 0, 2, 0x41, 0x88], 4).unwrap());
+        assert!(!is_idr(&[0, 0, 0, 1, 0x67], 4).unwrap());
+        assert!(!is_idr(&[1, 0x65, 1, 0x41], 1).unwrap());
+        for bytes in [vec![], vec![0], vec![0, 0, 0, 0], vec![0, 0, 0, 2, 0x65]] {
+            assert!(is_idr(&bytes, 4).is_err());
+        }
+    }
+    #[test]
+    fn split_keeps_earlier_frame_on_integer_midpoint_ties() {
+        assert_eq!(epoch_end(1950, Some(2050), 500, 10), 5);
+        assert_eq!(epoch_end(1949, Some(2050), 500, 10), 4);
+    }
+    fn cancelled_merge(panic: bool, fail_epoch: usize) {
+        let (tx, rx) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            let data = std::fs::read(concat!(
+                env!("CARGO_MANIFEST_DIR"),
+                "/fixtures/dual-idr.mp4"
+            ))
+            .unwrap();
+            let mp4 = Mp4::parse(&data).unwrap();
+            let result = decode_h264_mp4(
+                &mp4,
+                VideoConfig {
+                    resolution: 32,
+                    window_ms: 50,
+                    audio_duration_ms: 4150,
+                    decoder_threads: 0,
+                    workers: 2,
+                    queue_slots: 0,
+                },
+                &Metrics::new(false),
+                &crate::concurrency::Cancellation::new(),
+                None,
+                |epoch, _, _| {
+                    if epoch == fail_epoch {
+                        assert!(!panic, "injected merge panic");
+                        bail!("injected merge failure");
+                    }
+                    Ok(())
+                },
+            );
+            tx.send(result.unwrap_err().to_string()).unwrap();
+        });
+        let error = rx
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("partition workers did not join");
+        assert!(
+            error.contains(if panic {
+                "panicked"
+            } else {
+                "injected merge failure"
+            }),
+            "{error}"
+        );
+    }
+    #[test]
+    fn real_decoders_join_after_first_span_merge_failure() {
+        cancelled_merge(false, 0);
+    }
+    #[test]
+    fn real_decoders_join_after_second_span_merge_failure() {
+        cancelled_merge(false, 45);
+    }
+    #[test]
+    fn real_decoders_join_after_merge_panic() {
+        cancelled_merge(true, 0);
+    }
+}
