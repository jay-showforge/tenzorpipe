+#[derive(Clone, Copy, Debug)]
+struct PartitionPlan {
+    split: usize,
+    epoch: usize,
+    total_epochs: usize,
+    previous: i64,
+    next: i64,
+}
+
+/// Inspect NAL headers, not just the container's keyframe flag. All VCL NALs
+/// in the access unit must be IDR slices; partition starts are never inferred
+/// from an ordinary I picture or a recovery-point SEI.
+fn is_idr(mut data: &[u8], length_size: usize) -> Result<bool> {
+    anyhow::ensure!((1..=4).contains(&length_size), "invalid AVC length size");
+    anyhow::ensure!(!data.is_empty(), "empty AVC sample");
+    let mut idr = false;
+    let mut other_vcl = false;
+    while !data.is_empty() {
+        anyhow::ensure!(data.len() >= length_size, "truncated AVCC NAL length");
+        let n = data[..length_size]
+            .iter()
+            .fold(0usize, |v, b| (v << 8) | *b as usize);
+        data = &data[length_size..];
+        anyhow::ensure!(
+            n > 0 && n <= data.len(),
+            "invalid/truncated AVCC NAL payload"
+        );
+        let kind = data[0] & 31;
+        anyhow::ensure!(data[0] & 128 == 0 && kind != 0, "invalid AVC NAL header");
+        idr |= kind == 5;
+        other_vcl |= matches!(kind, 1..=4 | 19..=21);
+        data = &data[n..];
+    }
+    Ok(idr && !other_vcl)
+}
+
+/// Two metadata passes and O(1) partition state. No per-frame index is retained.
+/// A conservative fallback protects edit-list clipping and cross-boundary PTS.
+fn partition_plan(
+    mp4: &Mp4<'_>,
+    config: VideoConfig,
+    cancel: &crate::concurrency::Cancellation,
+    input_mapping: Option<&memmap2::Mmap>,
+) -> Result<Option<PartitionPlan>> {
+    let track = mp4
+        .tracks()
+        .iter()
+        .find(|t| t.kind() == TrackKind::Video && t.codec() == Some(Codec::H264))
+        .context("no supported H.264 video track found")?;
+    let Some(SampleEntry::Video(v)) = track.sample_entry() else {
+        bail!("missing video entry")
+    };
+    let CodecConfig::Avc(c) = &v.config else {
+        bail!("missing AVC configuration")
+    };
+    let avc = parse_avcc_config(&c.raw).map_err(anyhow::Error::msg)?;
+    let timeline = Timeline::for_track(track, mp4.timescale())?;
+    let pts = |cts| (timeline.pts_sec(cts, track.timescale()) * 1000.).round() as i64;
+    let middle = timeline.duration_sec * 500.;
+    let mut best: Option<(usize, f64)> = None;
+    for (index, sample) in track.samples().enumerate() {
+        cancel.check()?;
+        // Limit input-page residency during indexing. A full-file scan without
+        // this release made RSS scale with compressed file size before decode.
+        if index % 128 == 0 {
+            release_index_pages(input_mapping)?;
+        }
+        let sample = sample.context("index H.264 IDR samples")?;
+        if sample.is_sync && is_idr(sample.data, avc.length_size)? {
+            let p = pts(sample.cts);
+            if index > 0 && p > 0 && (p as f64) < timeline.duration_sec * 1000. {
+                let distance = (p as f64 - middle).abs();
+                if best.is_none_or(|(_, old)| distance < old) {
+                    best = Some((index, distance));
+                }
+            }
+        }
+    }
+    release_index_pages(input_mapping)?;
+    let Some((split, _)) = best else {
+        return Ok(None);
+    };
+    let mut previous = None;
+    let mut next = None;
+    let mut left_max = i64::MIN;
+    let mut right_min = i64::MAX;
+    for (index, sample) in track.samples().enumerate() {
+        cancel.check()?;
+        // Limit input-page residency during indexing. A full-file scan without
+        // this release made RSS scale with compressed file size before decode.
+        if index % 128 == 0 {
+            release_index_pages(input_mapping)?;
+        }
+        let sample = sample.context("verify H.264 partition presentation ranges")?;
+        let p = pts(sample.cts);
+        let display = p >= 0 && (p as f64) < timeline.duration_sec * 1000.;
+        if index < split {
+            left_max = left_max.max(p);
+            if display {
+                previous = Some(previous.map_or(p, |v: i64| v.max(p)));
+            }
+        } else {
+            right_min = right_min.min(p);
+            if display {
+                next = Some(next.map_or(p, |v: i64| v.min(p)));
+            }
+        }
+    }
+    release_index_pages(input_mapping)?;
+    if left_max >= right_min {
+        return Ok(None);
+    }
+    let (Some(previous), Some(next)) = (previous, next) else {
+        return Ok(None);
+    };
+    let duration_ms = (timeline.duration_sec * 1000.).round() as u64;
+    let total_epochs = duration_ms
+        .max(config.audio_duration_ms)
+        .div_ceil(config.window_ms) as usize;
+    let epoch = epoch_end(previous, Some(next), config.window_ms, total_epochs);
+    // Avoid spawning a worker which cannot contribute an epoch.
+    if epoch == 0 || epoch == total_epochs {
+        return Ok(None);
+    }
+    Ok(Some(PartitionPlan {
+        split,
+        epoch,
+        total_epochs,
+        previous,
+        next,
+    }))
+}
+
+fn decode_dual<F>(
+    mp4: &Mp4<'_>,
+    config: VideoConfig,
+    metrics: &Metrics,
+    cancel: &crate::concurrency::Cancellation,
+    plan: PartitionPlan,
+    mut on_epoch: F,
+) -> Result<VideoInfo>
+where
+    F: FnMut(usize, i64, &[f32]) -> Result<()>,
+{
+    use crate::concurrency::{CancelOnDrop, Cancelled, Message, VideoEpoch, check_index, worker};
+    let track = mp4
+        .tracks()
+        .iter()
+        .find(|t| t.kind() == TrackKind::Video && t.codec() == Some(Codec::H264))
+        .unwrap();
+    let spans = [
+        Span {
+            start: 0,
+            end: plan.split,
+            epoch_start: 0,
+            epoch_end: plan.epoch,
+            successor: Some(plan.next),
+            worker: 0,
+        },
+        Span {
+            start: plan.split,
+            end: track.sample_count(),
+            epoch_start: plan.epoch,
+            epoch_end: plan.total_epochs,
+            successor: None,
+            worker: 1,
+        },
+    ];
+    std::thread::scope(|scope| {
+        // This guard also handles allocation/spawn failures and collector panics.
+        let mut guard = CancelOnDrop(Some(cancel));
+        // Total slots across the two video sub-workers equals the original video
+        // allowance. The outer video channel is rendezvous in dual mode.
+        let capacities = [config.queue_slots.div_ceil(2), config.queue_slots / 2];
+        let mut receivers = Vec::with_capacity(2);
+        let mut handles = Vec::with_capacity(2);
+        for span in spans {
+            let (tx, rx) = crossbeam_channel::bounded(capacities[span.worker]);
+            receivers.push(rx);
+            handles.push(
+                std::thread::Builder::new()
+                    .name(format!("tenzor-video-{}", span.worker))
+                    .spawn_scoped(scope, move || {
+                        let started = metrics.start();
+                        let result = worker(
+                            || {
+                                let info = decode_span(
+                                    mp4,
+                                    config,
+                                    metrics,
+                                    cancel,
+                                    Some(span),
+                                    |index, pts, tensor| {
+                                        cancel.send_stage(
+                                            &tx,
+                                            Message::Data(VideoEpoch {
+                                                index,
+                                                pts,
+                                                values: tensor.to_vec(),
+                                            }),
+                                            metrics,
+                                            if span.worker == 0 {
+                                                Stage::VideoSend0
+                                            } else {
+                                                Stage::VideoSend1
+                                            },
+                                        )
+                                    },
+                                )?;
+                                cancel.send_stage(
+                                    &tx,
+                                    Message::End(span.epoch_end),
+                                    metrics,
+                                    if span.worker == 0 {
+                                        Stage::VideoSend0
+                                    } else {
+                                        Stage::VideoSend1
+                                    },
+                                )?;
+                                Ok(info)
+                            },
+                            cancel,
+                            if span.worker == 0 {
+                                "video 0"
+                            } else {
+                                "video 1"
+                            },
+                        );
+                        metrics.end(
+                            if span.worker == 0 {
+                                Stage::VideoWall0
+                            } else {
+                                Stage::VideoWall1
+                            },
+                            started,
+                        );
+                        result
+                    })
+                    .context("spawn independent video decoder")?,
+            );
+        }
+        let collected = worker(
+            || -> Result<()> {
+                let mut expected = 0;
+                for (span, rx) in spans.iter().zip(&receivers) {
+                    loop {
+                        match cancel.recv_stage(rx, metrics, Stage::VideoMergeWait)? {
+                            Message::Data(v) => {
+                                check_index(v.index, expected)?;
+                                anyhow::ensure!(
+                                    expected < span.epoch_end,
+                                    "partition emitted extra epoch"
+                                );
+                                on_epoch(v.index, v.pts, &v.values)?;
+                                expected += 1;
+                            }
+                            Message::End(n) => {
+                                anyhow::ensure!(
+                                    n == span.epoch_end && expected == n,
+                                    "partition EOF/count mismatch"
+                                );
+                                break;
+                            }
+                        }
+                    }
+                }
+                anyhow::ensure!(
+                    expected == plan.total_epochs,
+                    "incomplete partitioned video"
+                );
+                Ok(())
+            },
+            cancel,
+            "video merge",
+        );
+        drop(receivers);
+        let mut infos = Vec::with_capacity(2);
+        let mut failure = None;
+        for handle in handles {
+            match handle
+                .join()
+                .unwrap_or_else(|_| Err(anyhow::anyhow!("video thread panic outside worker")))
+            {
+                Ok(info) => infos.push(info),
+                Err(e) if !e.is::<Cancelled>() && failure.is_none() => failure = Some(e),
+                Err(_) => (),
+            }
+        }
+        if let Err(ref e) = collected
+            && !e.is::<Cancelled>()
+        {
+            return Err(collected.unwrap_err());
+        }
+        if let Some(e) = failure {
+            return Err(e);
+        }
+        collected?;
+        anyhow::ensure!(infos.len() == 2, "video partition cancelled");
+        let mut info = infos.remove(0);
+        info.sample_count += infos[0].sample_count;
+        info.resized_count += infos[0].resized_count;
+        guard.0 = None;
+        Ok(info)
+    })
+}
+
+/// Only residency changes: the immutable source remains mapped and valid.
+fn release_index_pages(input_mapping: Option<&memmap2::Mmap>) -> Result<()> {
+    #[cfg(unix)]
+    if let Some(mapping) = input_mapping {
+        // Same immutable-input contract as the existing batch-level page release.
+        unsafe {
+            mapping.unchecked_advise(memmap2::UncheckedAdvice::DontNeed)?;
+        }
+    }
+    #[cfg(not(unix))]
+    let _ = input_mapping;
+    Ok(())
+}
