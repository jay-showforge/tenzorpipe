+                for pair in pts.windows(2) {
+                    let midpoint = pair[0] + (pair[1] - pair[0]) / 2;
+                    while legacy.len() < total && (legacy.len() as u64 * window) as i64 <= midpoint
+                    {
+                        legacy.push(pair[0]);
+                    }
+                }
+                legacy.resize(total, *pts.last().unwrap());
