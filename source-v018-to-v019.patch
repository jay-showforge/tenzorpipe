+/// Must live inside the thread scope so cancellation precedes implicit joins.
+pub(crate) struct CancelOnDrop<'a>(pub Option<&'a Cancellation>);
+impl Drop for CancelOnDrop<'_> {
+    fn drop(&mut self) {
+        if let Some(c) = self.0 {
+            c.cancel();
+        }
+    }
 }
 
